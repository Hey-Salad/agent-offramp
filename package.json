    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "stripe": "^23.0.0",
    "twilio": "^6.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "playwright": "1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
