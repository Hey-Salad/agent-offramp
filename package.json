  "description": "Sally: give your AI a card it can't misuse. Policy-bound money agent on Stripe (test mode).",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "tsc --noEmit --skipLibCheck --module nodenext --moduleResolution nodenext --target es2022 --resolveJsonModule --noImplicitAny false src/ui.ts src/stripe-extra.ts src/mcp.ts",
    "test": "node test/ui.test.mjs && node test/stripe-extra.test.mjs",
    "demo": "node demo/run.mjs",
    "demo:test": "node --test demo/pipeline.test.mjs",
    "demo:irish": "node demo/run.mjs --irish"
  },
  "keywords": [],
