# Set privately in demo/.env (gitignored). Never put these values in shell logs.
APP_URL=
ELEVENLABS_API_KEY=
# Optional: use another voice already accessible to your ElevenLabs account.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_VOICE_NAME=
# OpenAI is used only for final audio alignment verification.
OPENAI_API_KEY=
# App-side: STRIPE_SECRET_KEY must be sk_test_...; an Issuing-enabled test
# account/card is required. A hosted target owns its own Stripe configuration.
