      "duration": 4.266666666666667,
      "voiceDuration": 4.249896,
      "playbackRate": 1
    },
    {
      "id": "approve",
      "text": "This item is over twenty-five pounds, so she asks me first. One click, and it's paid.",
      "start": 9.533333333333333,
